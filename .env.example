# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Slack Bot Token (xoxb-...)
# Permissions needed: channels:history, groups:history, im:history, mpim:history,
#                     search:read, chat:write, im:write
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_ID=U02G57N1UDP

# Circleback API key (from Settings → Integrations → API)
CIRCLEBACK_API_KEY=...

# Gmail OAuth2 credentials
# Create via Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Scopes needed: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CLIENT_ID=...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//...
