# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token (xoxb-) para enviar mensajes. User token (xoxp-) para leer canales.
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...

# ID del usuario o canal donde se envía el resumen.
# Para DM usa el user_id de Slack (Ej: U02G57N1UDP).
SLACK_SUMMARY_RECIPIENT=U02G57N1UDP

# Canales a incluir en el resumen (separados por coma). Vacío = todos.
# Ejemplo: general,ventas,producto
SLACK_CHANNELS=

# ── Circleback ────────────────────────────────────────────────────────────────
# API key de Circleback (Settings → API en app.circleback.ai)
CIRCLEBACK_API_KEY=

# ── Gmail ────────────────────────────────────────────────────────────────────
# Ruta al archivo credentials.json descargado de Google Cloud Console.
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
# Ruta donde se guarda el token OAuth2 (se genera automáticamente con setup_gmail_auth.py)
GMAIL_TOKEN_PATH=credentials/gmail_token.json

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Configuración general ────────────────────────────────────────────────────
TIMEZONE=America/Mexico_City

# Dominio(s) de la empresa para filtrar correos internos (separados por coma)
DACODES_DOMAINS=dacodes.com,dacodes.mx,dacodes.ai
