# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Slack Bot Token (xoxb-...)
# Required scopes: channels:history, groups:history, im:history, mpim:history,
#                  channels:read, groups:read, im:read, mpim:read,
#                  chat:write, users:read
SLACK_BOT_TOKEN=xoxb-...

# Your Slack User ID (the DM destination)
SLACK_USER_ID=U02G57N1UDP

# Circleback API key (from app.circleback.ai → Settings → API)
CIRCLEBACK_API_KEY=...

# Gmail credentials JSON (generated by setup_gmail_credentials.py)
GMAIL_CREDENTIALS={"token":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.readonly"]}
