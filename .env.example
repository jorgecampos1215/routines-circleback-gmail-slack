# Copy this file to .env for local testing (never commit .env)

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Slack Bot Token (xoxb-...) — needs scopes: chat:write, search:read
# Create app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...

# Slack User ID to receive the DM (your personal user ID)
SLACK_USER_ID=U02G57N1UDP

# Circleback API key — https://app.circleback.ai/settings/api
CIRCLEBACK_API_KEY=...

# Gmail OAuth2 token — base64-encoded JSON with these fields:
# { "token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "...", "token_uri": "https://oauth2.googleapis.com/token" }
# Generate with: python scripts/generate_gmail_token.py | base64
GMAIL_TOKEN_JSON=...
