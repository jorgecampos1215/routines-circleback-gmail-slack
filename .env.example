# Copy this to .env and fill in your values (never commit .env to git)

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Slack — Bot OAuth Token (xoxb-...)
# Required scopes: channels:history, channels:read, groups:history, groups:read,
#                  im:history, mpim:history, chat:write, users:read
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_ID=U02G57N1UDP

# Circleback
CIRCLEBACK_API_KEY=...
# Optional override (default: https://api.circleback.ai)
# CIRCLEBACK_BASE_URL=https://api.circleback.ai

# Gmail OAuth credentials as a single JSON string:
# {
#   "token": "ya29...",           ← current access token (can be empty)
#   "refresh_token": "1//...",    ← required
#   "client_id": "....apps.googleusercontent.com",
#   "client_secret": "GOCSPX-..."
# }
# See README for how to generate these credentials.
GMAIL_CREDENTIALS_JSON={"token":"","refresh_token":"1//...","client_id":"...","client_secret":"..."}
