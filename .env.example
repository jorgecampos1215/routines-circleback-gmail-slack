# Copia este archivo como .env y llena los valores
# NUNCA subas el .env al repositorio

# API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Slack OAuth token del bot/app (api.slack.com/apps → OAuth & Permissions)
# Scopes requeridos: channels:history, channels:read, groups:history, groups:read,
#                   im:history, im:read, im:write, mpim:history, mpim:read,
#                   search:read, chat:write, users:read
SLACK_MCP_TOKEN=xoxp-...

# Circleback API key (app.circleback.ai → Settings → API)
CIRCLEBACK_API_KEY=cb_...

# Gmail OAuth access token (ver README para obtenerlo)
GMAIL_OAUTH_TOKEN=ya29...

# Tu Slack User ID (por defecto U02G57N1UDP)
SLACK_USER_ID=U02G57N1UDP
