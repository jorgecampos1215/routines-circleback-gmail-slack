# Copia este archivo a .env.local (no se sube al repo) y llena los valores de tu proyecto de Supabase.
# Supabase → Project Settings → API

# Las usa el navegador (Vite expone solo las variables que empiezan con VITE_). Pónlas también en Vercel.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# Solo para `npm run seed:supabase` en tu máquina. NUNCA la pongas en Vercel ni con prefijo VITE_.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
